css
/* ==========================================================================
   1. DESIGN SYSTEM & BASICS
   ========================================================================== */
:root {
    --bg-main: #f8fafc;        /* Clean Off-White */
    --bg-card: #ffffff;        /* Pure White */
    --text-dark: #0f172a;      /* Deep Denim Anthracite */
    --text-muted: #475569;     /* Slate Gray */
    --accent: #e15f3f;         /* Matte Copper Orange (Stitching-Vibe) */
    --border-color: #e2e8f0;   /* Subtle Gray for Borders */
    --max-width: 1100px;
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-sans);
    background-color: var(--bg-main);
    color: var(--text-dark);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
}

/* ==========================================================================
   2. HEADER & NAVIGATION (Minimal & Sticky)
   ========================================================================== */
header {
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.nav-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo h1 {
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 900;
}

.logo span {
    color: var(--accent);
}

nav ul {
    display: flex;
    list-style: none;
    gap: 2.5rem;
}

nav a {
    font-weight: 500;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 1px;
    color: var(--text-muted);
    transition: color 0.3s ease, border-color 0.3s ease;
    padding: 0.5rem 0;
    border-bottom: 2px solid transparent;
}

nav a:hover, nav a.active {
    color: var(--text-dark);
    border-bottom: 2px solid var(--text-dark);
}

/* ==========================================================================
   3. HERO HERO SECTION (Premium & Emotional)
   ========================================================================== */
.hero {
    background: linear-gradient(rgba(15, 23, 42, 0.6), rgba(15, 23, 42, 0.7)), 
                url('https://unsplash.com') no-repeat center center/cover;
    color: #ffffff;
    padding: 8rem 2rem;
    text-align: center;
}

.hero-content {
    max-width: 750px;
    margin: 0 auto;
}

.hero h2 {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: -1px;
}

.hero p {
    font-size: 1.25rem;
    margin-bottom: 2.5rem;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 300;
}

.btn {
    display: inline-block;
    background-color: var(--bg-card);
    color: var(--text-dark);
    padding: 1rem 2.5rem;
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    border-radius: 0; /* Minimalist Square Corners */
    transition: background-color 0.3s ease, color 0.3s ease, transform 0.2s ease;
    border: 1px solid var(--text-dark);
    cursor: pointer;
}

.btn:hover {
    background-color: var(--text-dark);
    color: #ffffff;
    transform: translateY(-2px);
}

.btn-primary {
    background-color: var(--accent);
    color: #ffffff;
    border: none;
}

.btn-primary:hover {
    background-color: var(--text-dark);
}

/* ==========================================================================
   4. CONTENT LAYOUTS (Spacious & Balanced)
   ========================================================================== */
main {
    max-width: var(--max-width);
    margin: 6rem auto;
    padding: 0 2rem;
}

.section-block {
    margin-bottom: 8rem;
}

.section-title {
    font-size: 2rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 3.5rem;
    text-align: center;
}

/* Modern Card Grid */
.grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem;
}

.card {
    background-color: var(--bg-card);
    padding: 3rem 2.5rem;
    border: 1px solid var(--border-color);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(15, 23, 42, 0.05);
}

.card h3 {
    font-size: 1.3rem;
    text-transform: uppercase;
    margin-bottom: 1rem;
    letter-spacing: 0.5px;
}

.card p {
    color: var(--text-muted);
    font-size: 0.95rem;
}

/* Clean Split Layout */
.split-section {
    display: flex;
    align-items: center;
    gap: 4rem;
}

.split-text {
    flex: 1;
}

.split-text h3 {
    font-size: 1.8rem;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    line-height: 1.3;
}

.split-text p {
    color: var(--text-muted);
    margin-bottom: 2rem;
}

.split-image {
    flex: 1;
    height: 400px;
    overflow: hidden;
}

.split-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* ==========================================================================
   5. FOOTER (Clean & Uniform)
   ========================================================================== */
footer {
    background-color: var(--text-dark);
    color: #ffffff;
    padding: 5rem 2rem 2rem;
}

.footer-container {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 4rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 4rem;
}

.footer-col h4 {
    color: var(--accent);
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 1px;
    margin-bottom: 1.5rem;
}

.footer-col p {
    color: rgba(255,255,255,0.7);
    font-size: 0.9rem;
}

.footer-col ul {
    list-style: none;
}

.footer-col ul li {
    margin-bottom: 0.7rem;
    color: rgba(255,255,255,0.7);
    font-size: 0.9rem;
}

.footer-bottom {
    max-width: var(--max-width);
    margin: 2rem auto 0;
    text-align: center;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.5px;
}

/* ==========================================================================
   6. RESPONSIVITY & MOBILE OVERRIDES
   ========================================================================== */
@media (max-width: 900px) {
    .split-section {
        flex-direction: column;
        gap: 3rem;
    }
    .split-image {
        width: 100%;
        height: 300px;
    }
}

@media (max-width: 768px) {
    .nav-container {
        flex-direction: column;
        gap: 1.5rem;
        padding: 1.5rem 1rem;
    }
    nav ul {
        gap: 1.5rem;
    }
    .hero {
        padding: 6rem 1rem;
    }
    .hero h2 {
        font-size: 2rem;
    }
    main {
        margin: 4rem auto;
        padding: 0 1.5rem;
    }
    .section-block {
        margin-bottom: 5rem;
    }
}
